# Shared across Node services
# Local dev / npm run seed on host → localhost or 127.0.0.1. Inside Docker Compose → mongodb://mongo:27017
MONGO_URI=mongodb://127.0.0.1:27017
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-long-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_SECRET=change-me-internal-service-secret

# Preference → AI automation (schedule-service BullMQ worker; דיבאונס לאיחוד הגשות לפני ריצה — מוגבל למקסימום 10 שניות)
# PREFERENCE_AI_DEBOUNCE_MS=10000
# Optional: ברירות מחדל לדרישות office בזרימה האוטומטית (אם לא מוגדר — 3 ו-50 בהתאמה)
# PREFERENCE_AI_MIN_OFFICE_PER_DAY=3
# PREFERENCE_AI_MAX_OFFICE_CAPACITY=50
# משתמש «מערכת» כ-createdBy להמלצות AI מהצינור; אם לא מוגדר, נוקח את האדמין הראשון ממסד העובדים
# SYSTEM_ACTOR_EMPLOYEE_ID=

# Service-to-service (location-service → schedule / employee; report-service → schedule / employee / location / notification)
SCHEDULE_SERVICE_URL=http://127.0.0.1:4005
EMPLOYEE_SERVICE_URL=http://127.0.0.1:4002
LOCATION_SERVICE_URL=http://127.0.0.1:4004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4006
REPORT_SERVICE_URL=http://127.0.0.1:4008
AI_SERVICE_URL=http://127.0.0.1:4007
DEPARTMENT_SERVICE_URL=http://127.0.0.1:4003
CORS_ORIGIN=http://localhost:5173

# OpenAI (optional — AI service falls back to mock recommendations)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: upsert dev login (npm run ensure:dev-user) — dev only
# DEV_LOGIN_EMAIL=ronenc7@gmail.com
# DEV_LOGIN_PASSWORD=12345678

# Auth bootstrap
# In production: registration is allowed only for an empty employees DB, or set ALLOW_PUBLIC_REGISTER=true.
# In non-production: registration stays open by default; set ALLOW_PUBLIC_REGISTER=false to force closed.
ALLOW_PUBLIC_REGISTER=false

# Notifications
INCLUDE_ADMINS_IN_SCHEDULE_NOTIFICATIONS=true
# Preference reminder worker (notification-service, BullMQ + Redis repeat job)
# PREFERENCE_REMINDER_INTERVAL_MS=86400000
# PREFERENCE_REMINDER_COOLDOWN_HOURS=48

# SMTP (notification-service: מיילים, כולל דוחות PDF). ברירת מחדל בקוד: localhost:1025 = MailHog (אין משלוח ל-Gmail).
# אחרי `npm run docker:deps` — ממשק קריאת מיילים: http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=noreply@seeyoutomorrow.local
# לדוגמה SendGrid / ספק אחר — עדכנו HOST/PORT/USER/PASS/FROM בהתאם לתיעוד הספק.

# Client (Vite)
VITE_API_BASE=
# Optional: looped MP4 for dashboard + public home background (default: Mixkit “team with laptops”)
# VITE_DASHBOARD_BG_VIDEO_URL=https://example.com/your-loop.mp4
# Optional alias (if set, overrides when DASHBOARD unset): home + dashboard
# VITE_SITE_BG_VIDEO_URL=https://example.com/your-loop.mp4
# Optional: axios timeout ms (default 45000)
# VITE_API_TIMEOUT_MS=45000
