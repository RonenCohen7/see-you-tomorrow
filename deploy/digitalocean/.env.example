# Copy to deploy/digitalocean/.env on the server. Do not commit the real file.

DOMAIN=app.example.com
PUBLIC_APP_URL=https://app.example.com

# Long random strings. Generate with: openssl rand -base64 48
JWT_SECRET=change-me
INTERNAL_SERVICE_SECRET=change-me-too

# Password reset and other mail. The droplet cannot reach Gmail SMTP.
# Create a Resend API key, verify the domain, then set:
# RESEND_API_KEY=
# RESEND_FROM=See You Tomorrow <noreply@whosintomorrow.com>

# Optional AI
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
